# WordPress / WooCommerce origin, e.g. https://admin.orvexo.us
# Install wordpress/orvexo-storefront-footer so Appearance → Menus
# drives the Next.js footer via /wp-json/orvexo/v1/footer
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encrypts payment accounts saved in Admin. 32-byte key, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_CONFIG_KEY=

# Vercel Blob read-write token. Admin saves Stripe, PayPal, Affirm, and
# Afterpay keys into this private store. Create a Blob store in the Vercel
# project and paste the token here and on Vercel.
BLOB_READ_WRITE_TOKEN=

# Local only (yes/no). yes skips the Stripe charge only. Catalog, cart, and
# the Woo order (pending then set_paid) still go through WooCommerce.
# Ignored in production (Vercel). Do not set this on Vercel.
SKIP_STRIPE_PAYMENT=no

# Vercel (Production / Preview)
# Set WC_URL, the Woo consumer keys, NEXT_PUBLIC_SITE_URL, PAYMENT_CONFIG_KEY,
# and BLOB_READ_WRITE_TOKEN. Enter payment keys in /admin, not in env.
# Stripe Dashboard webhook:
#   https://YOUR-PROJECT.vercel.app/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled
# Paste the endpoint signing secret (whsec_...) into Admin → Stripe.
# NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
